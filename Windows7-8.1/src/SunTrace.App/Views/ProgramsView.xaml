<UserControl x:Class="SunTrace.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SunTrace.App.Controls"
             xmlns:loc="clr-namespace:SunTrace.App.Localization">

    <UserControl.Resources>
        <Style x:Key="PlainListItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VirtualRowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <Grid Width="300" Margin="0,0,12,8">
                <controls:PlaceholderTextBox Style="{StaticResource SearchBox}"
                                             Placeholder="{loc:Loc Ui.SearchPrograms}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Path Width="14" Height="14" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Data="{StaticResource Icon.Search}" Stretch="Uniform"
                      Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="0,0,16,8" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="{loc:Loc Ui.Sort}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource Dropdown}"
                          Width="210"
                          ItemsSource="{Binding SortOptions}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding Sort, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource FilterRadio}"
                             GroupName="ProgramFilter"
                             Content="{loc:Loc Ui.All}"
                             Margin="0,0,6,6"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="All"
                             IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=All, Mode=OneWay}" />
                <RadioButton Style="{StaticResource FilterRadio}"
                             GroupName="ProgramFilter"
                             Content="{loc:Loc Ui.HasChanges}"
                             Margin="0,0,6,6"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Changed"
                             IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=Changed, Mode=OneWay}" />
                <RadioButton Style="{StaticResource FilterRadio}"
                             GroupName="ProgramFilter"
                             Content="{loc:Loc Ui.NeedsCheck}"
                             Margin="0,0,6,6"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Attention"
                             IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=Attention, Mode=OneWay}" />
                <RadioButton Style="{StaticResource FilterRadio}"
                             GroupName="ProgramFilter"
                             Content="{loc:Loc Ui.HasPaused}"
                             Margin="0,0,6,6"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Paused"
                             IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=Paused, Mode=OneWay}" />
                <Button Content="{loc:Loc Ui.Reset}" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Margin="4,0,0,6" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Divider}" Margin="0,0,0,12" />

        <Grid Grid.Row="3">
            <ListBox x:Name="AppsList"
                     Style="{StaticResource VirtualRowList}"
                     ItemsSource="{Binding Rows}"
                     ItemTemplate="{StaticResource AppRowTemplate}"
                     Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyStateView Title="{Binding EmptyTitle}"
                                     Message="{Binding EmptyMessage}"
                                     Icon="{DynamicResource Icon.Apps}"
                                     ActionText="{loc:Loc Ui.CheckNow}"
                                     ActionCommand="{Binding Main.ScanNowCommand}"
                                     Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
