<UserControl x:Class="SunTrace.App.Views.ProgramDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SunTrace.App.Controls"
             xmlns:loc="clr-namespace:SunTrace.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,8">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,2,14,0">
                        <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="{loc:Loc Ui.Back}">
                            <Path Width="15" Height="15" Data="{StaticResource Icon.ArrowLeft}" Stretch="Uniform"
                                  Stroke="{DynamicResource App.TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <controls:AppIcon Size="64" Margin="0,14,0,0" AppName="{Binding Title}" IconPath="{Binding IconPath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding VersionLabel}" FontSize="10.5" Foreground="{DynamicResource App.TextSecondary}" />
                            </Border>
                            <Border Background="{DynamicResource App.BadgeNeutral}" CornerRadius="6" Padding="9,3"
                                    Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource AppStatusBrush}}" />
                                    <TextBlock Text="{Binding Status, Converter={StaticResource AppStatusLabel}}"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource AppStatusBrush}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusNote}" Style="{StaticResource Text.Meta}" Margin="0,9,0,0"
                                   Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="{DynamicResource App.BadgeNeutral}" CornerRadius="6" Padding="9,4" Margin="0,9,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Ui.ExcludedNote}" FontSize="10.5"
                                       Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Ui.ProgramHistory}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenHistoryCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="{loc:Loc Ui.OpenFolder}" Style="{StaticResource GhostButton}" Command="{Binding OpenLocationCommand}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" IsEnabled="{Binding HasInstallLocation}" />
                        <Button Content="{loc:Loc Ui.AddToExclusions}" Style="{StaticResource GhostButton}" Command="{Binding ToggleExclusionCommand}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                Visibility="{Binding IsExcluded, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="{loc:Loc Ui.RemoveFromExclusions}" Style="{StaticResource GhostButton}" Command="{Binding ToggleExclusionCommand}"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="HTML" Style="{StaticResource GhostButton}" Command="{Binding ExportHtmlCommand}" ToolTip="{loc:Loc Ui.ExportHtmlTip}" />
                            <Button Content="JSON" Style="{StaticResource GhostButton}" Command="{Binding ExportJsonCommand}" ToolTip="{loc:Loc Ui.ExportJsonTip}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14"
                    Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Ui.ProgramChanges}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{Binding EventsLabel}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Ui.OpenInHistory}" Style="{StaticResource InlineLinkButton}" Command="{Binding OpenHistoryCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventCardTemplate}"
                                  Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{loc:Loc Ui.ShowMore}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMoreEvents, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14"
                  Visibility="{Binding IsMissing, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14"
                        Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.Components}" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="{Binding ComponentsLabel}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Ui.DisabledComponents}" Style="{StaticResource InlineLinkButton}" Command="{Binding OpenPausedCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ComponentGroups}"
                                      Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="0,0,0,2">
                                        <Expander.Header>
                                            <Grid Margin="2,6,2,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Width="14" Height="14" Data="{Binding Type, Converter={StaticResource ComponentIcon}}"
                                                      Stretch="Uniform" Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ComponentRowTemplate}" Margin="0,1,0,4" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Ui.Details}" Style="{StaticResource Text.H3}" Margin="0,0,0,10" />
                            <TextBlock Text="{loc:Loc Ui.Publisher}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc Ui.Version}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9" />
                            <TextBlock Text="{loc:Loc Ui.Installed}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding InstallDateLabel}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9" />
                            <TextBlock Text="{loc:Loc Ui.Updated}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding LastUpdatedLabel}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9" />
                            <TextBlock Text="{loc:Loc Ui.LastChange}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding LastChangeLabel}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9" />
                            <TextBlock Text="{loc:Loc Ui.Source}" Style="{StaticResource Text.LabelCaps}" />
                            <TextBlock Text="{Binding AppInfo.RegistryKey, TargetNullValue=-}" Style="{StaticResource Text.Mono}" Margin="0,3,0,0" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                            Visibility="{Binding UninstallCommand, Converter={StaticResource StringToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Ui.Uninstall}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{loc:Loc Ui.UninstallDescription}"
                                       Style="{StaticResource Text.Meta}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UninstallCommand}" Style="{StaticResource Text.Mono}" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                            <Button Content="{loc:Loc Ui.CopyCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0" Margin="0,6,0,0"
                                    Command="{Binding CopyUninstallCommand}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <controls:EmptyStateView Title="{Binding Title}"
                                     Message="{Binding Publisher}"
                                     Icon="{DynamicResource Icon.Apps}"
                                     Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
