<Window x:Class="SunTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SunTrace.App.Controls"
        xmlns:localization="clr-namespace:SunTrace.App.Localization"
        Title="SunTrace"
        Icon="/Assets/SunTrace.ico"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        FontFamily="{DynamicResource App.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanNowCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource App.Sidebar}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderSidebarColumn" Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Stretch="Uniform" Source="/Assets/SunTrace.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="BrandText"
                               Text="SunTrace"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid x:Name="SearchHost" Grid.Column="1" Margin="8,0,24,0" MaxWidth="500" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:PlaceholderTextBox x:Name="SearchBox"
                                                 Style="{StaticResource SearchBox}"
                                                 Placeholder="{localization:Loc Ui.SearchAll}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Width="14"
                          Height="14"
                          Margin="11,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icon.Search}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource App.TextTertiary}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint"
                               Text="Ctrl K"
                               Margin="0,0,10,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource App.TextTertiary}"
                               IsHitTestVisible="False" />
                    <Popup IsOpen="{Binding IsSearchOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Width="470"
                                MaxHeight="430"
                                Margin="0,6,0,0"
                                Background="{DynamicResource App.Surface}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.14" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.SearchLabel]}"
                                               Style="{StaticResource Text.LabelCaps}"
                                               Margin="9,7,0,5" />
                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.NothingFound]}"
                                               Style="{StaticResource Text.Secondary}"
                                               Margin="10,6,10,12"
                                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Height="48"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7">
                                                            <Path Width="14"
                                                                  Height="14"
                                                                  Data="{Binding Kind, Converter={StaticResource SearchIcon}}"
                                                                  Stretch="Uniform"
                                                                  Stroke="{DynamicResource App.TextSecondary}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <Path Grid.Column="2"
                                                              Width="8"
                                                              Height="8"
                                                              Data="{StaticResource Icon.ChevronRight}"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource App.TextTertiary}"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Grid.Column="2" Margin="0,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="HeaderToolsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ScanNowCommand}"
                                ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.CheckSystem]}"
                                Width="32"
                                Height="32">
                            <Path Width="15"
                                  Height="15"
                                  Data="{StaticResource Icon.Refresh}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource App.TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource Icon.Minimize}" Click="Minimize_Click" ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Minimize]}" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Tag="{StaticResource Icon.Maximize}" Click="Maximize_Click" ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Maximize]}" />
                        <Button Style="{StaticResource CloseCaptionButton}" Tag="{StaticResource Icon.Close}" Click="Close_Click" ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Close]}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource App.Sidebar}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,16,10,12">
                            <TextBlock x:Name="NavCaption" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Navigation]}" Style="{StaticResource Text.LabelCaps}" Margin="12,0,0,8" />

                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="MainNavigation"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Overview"
                                         ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Overview]}"
                                         IsChecked="{Binding CurrentSectionName, Converter={StaticResource SectionChecked}, ConverterParameter=Overview, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.Home}" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="NavOverviewText" Grid.Column="1" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Overview]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="MainNavigation"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Programs"
                                         ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Programs]}"
                                         IsChecked="{Binding CurrentSectionName, Converter={StaticResource SectionChecked}, ConverterParameter=Programs, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.Apps}" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="NavProgramsText" Grid.Column="1" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Programs]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="MainNavigation"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="History"
                                         ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.History]}"
                                         IsChecked="{Binding CurrentSectionName, Converter={StaticResource SectionChecked}, ConverterParameter=History, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.History}" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="NavHistoryText" Grid.Column="1" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.History]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Border x:Name="HistoryBadge" Grid.Column="2" Background="{DynamicResource App.AccentSoft}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding AttentionCount, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding AttentionCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource App.AccentText}" />
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="MainNavigation"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Paused"
                                         ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Paused]}"
                                         IsChecked="{Binding CurrentSectionName, Converter={StaticResource SectionChecked}, ConverterParameter=Paused, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.PauseCircle}" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="NavPausedText" Grid.Column="1" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.PausedShort]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Border x:Name="PausedBadge" Grid.Column="2" Background="{DynamicResource App.BadgeNeutral}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding PausedCount, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding PausedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondary}" />
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="MainNavigation"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings"
                                         ToolTip="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Settings]}"
                                         IsChecked="{Binding CurrentSectionName, Converter={StaticResource SectionChecked}, ConverterParameter=Settings, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.Settings}" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="NavSettingsText" Grid.Column="1" Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Settings]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="PageHeader" Grid.Row="0" Margin="24,18,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.H1}" />
                    </StackPanel>
                    <StackPanel x:Name="PageHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderNextScan"
                                   Text="{Binding NextScanLabel}"
                                   Style="{StaticResource Text.Meta}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button x:Name="HeaderScanButton" Style="{StaticResource SecondaryButton}" Command="{Binding ScanNowCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Data="{StaticResource Icon.Refresh}" Stretch="Uniform"
                                      Stroke="{DynamicResource App.TextSecondary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.Check]}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TrackingButton}" Command="{Binding StartTrackingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Data="{StaticResource Icon.Plus}" Stretch="Uniform"
                                      Stroke="{DynamicResource App.Accent}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Shell.StartTracking]}" FontSize="12" Foreground="{DynamicResource App.TrackingForeground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="ScanProgressPanel" Grid.Row="1"
                        Margin="24,10,24,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Meta}" Margin="0,0,0,5" />
                            <ProgressBar Style="{StaticResource ProgressLine}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ScanPercent}"
                                         Height="3" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ScanPercentText}"
                                   Style="{StaticResource Text.Meta}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="2"
                                Content="{Binding CurrentPage}"
                                Margin="24,16,24,20"
                                Focusable="False" />
            </Grid>
        </Grid>

        <Border x:Name="ToastPanel" Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="20"
                Width="350"
                Margin="0,0,24,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="13,11"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="8" Height="8" Background="{DynamicResource App.Accent}" CornerRadius="4" VerticalAlignment="Top" Margin="0,5,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource App.Text}" LineHeight="18" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding DismissToastCommand}" Margin="8,0,0,0">
                    <Path Width="9" Height="9" Data="{StaticResource Icon.Close}" Stretch="Uniform"
                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
