<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SunTrace.App.Controls"
                    xmlns:loc="clr-namespace:SunTrace.App.Localization">

    <DataTemplate x:Key="EventCardTemplate">
        <Expander Margin="0,0,0,8">
            <Expander.Header>
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            VerticalAlignment="Top"
                            Background="{Binding Importance, Converter={StaticResource ImportanceSoftBrush}}"
                            CornerRadius="8">
                        <Path Width="16"
                              Height="16"
                              Data="{Binding ComponentType, Converter={StaticResource ComponentIcon}}"
                              Stretch="Uniform"
                              Stroke="{Binding Importance, Converter={StaticResource ImportanceBrush}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,14,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="0,3,0,0"
                                   MaxHeight="38"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding Kind, Converter={StaticResource ChangeKindLabel}}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                            <TextBlock Text="·" Margin="6,0" Style="{StaticResource Text.Meta}" />
                            <TextBlock Text="{Binding ComponentType, Converter={StaticResource ComponentTypeLabel}}" Style="{StaticResource Text.Meta}" />
                            <TextBlock Text="·" Margin="6,0" Style="{StaticResource Text.Meta}" />
                            <TextBlock Text="{Binding DetectedAt, Converter={StaticResource RelativeTime}}" Style="{StaticResource Text.Meta}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton Content="{loc:Loc Ui.ReadAll}"
                                      Style="{StaticResource ReadAllToggle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Mode=TwoWay}"
                                      ToolTip="{loc:Loc Ui.ReadAllTip}"
                                      Visibility="{Binding HasMultipleChanges, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,1,8,0" />
                        <Border CornerRadius="6"
                                Padding="8,3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Importance, Converter={StaticResource ImportanceSoftBrush}}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Importance}" Value="Attention">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Importance}" Value="Check">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Importance, Converter={StaticResource ImportanceLabel}}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Importance, Converter={StaticResource ImportanceBrush}}" />
                        </Border>
                        <Path Width="10"
                              Height="10"
                              Margin="0,10,2,0"
                              Data="{DynamicResource Icon.ChevronDown}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource App.TextTertiary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </StackPanel>
                </Grid>
            </Expander.Header>
            <Expander.Content>
                <Grid Margin="14,0,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Details.Explanation}"
                                   Style="{StaticResource Text.Body}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding Details.Explanation, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding Details.ComponentDetail}"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding Details.ComponentDetail, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding Details.Effect}"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding Details.Effect, Converter={StaticResource StringToVisibility}}" />

                        <StackPanel Visibility="{Binding Details.Fields.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{loc:Loc Ui.WhatChanged}" Style="{StaticResource Text.LabelCaps}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Ui.Parameter}" Style="{StaticResource Text.Meta}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Ui.BeforeChange}" Style="{StaticResource Text.Meta}" />
                                <TextBlock Grid.Column="2" Text="{loc:Loc Ui.AfterChange}" Style="{StaticResource Text.Meta}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Details.Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource App.Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Before, TargetNullValue=-}"
                                                           Margin="0,0,10,0"
                                                           FontFamily="{StaticResource App.MonoFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource App.TextSecondary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding After, TargetNullValue=-}"
                                                           FontFamily="{StaticResource App.MonoFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource App.Text}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding Details.SamplePaths.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{loc:Loc Ui.FoundObjects}" Style="{StaticResource Text.LabelCaps}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Details.SamplePaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource Text.Mono}"
                                                   Margin="0,2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding Details.Technical.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{loc:Loc Ui.Technical}" Style="{StaticResource Text.LabelCaps}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Details.Technical}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Meta}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Style="{StaticResource Text.Mono}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Expander.Content>
        </Expander>
    </DataTemplate>

    <DataTemplate x:Key="AppCardTemplate">
        <Button Style="{StaticResource CardButton}"
                Height="88"
                Margin="0,0,8,8"
                Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                CommandParameter="{Binding}">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AppIcon Size="40" AppName="{Binding Name}" IconPath="{Binding App.MainExecutablePath}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Meta}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Publisher, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding App.DisplayVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource App.BadgeNeutral}"
                        CornerRadius="6"
                        Padding="7,3"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource AppStatusBrush}}" />
                        <TextBlock Text="{Binding Status, Converter={StaticResource AppStatusLabel}}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource AppStatusBrush}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="AppRowTemplate">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AppCardTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="ComponentRowTemplate">
        <Border Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Background="{DynamicResource App.SurfaceAlt}"
                        CornerRadius="8">
                    <Path Width="15"
                          Height="15"
                          Data="{Binding Component.Type, Converter={StaticResource ComponentIcon}}"
                          Stretch="Uniform"
                          Stroke="{DynamicResource App.TextSecondary}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource Text.Meta}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="8,3" Background="{DynamicResource App.BadgeNeutral}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StateLabel}" FontSize="10.5" Foreground="{DynamicResource App.TextSecondary}" />
                    </Border>
                    <Button Content="{loc:Loc Ui.Disable}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding PauseCommand}"
                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProtectionNote}"
                               Style="{StaticResource Text.Meta}"
                               MaxWidth="150"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Visibility="{Binding ShowProtectionNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PausedCardTemplate">
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7">
                            <Path Width="14"
                                  Height="14"
                                  Data="{Binding ComponentType, Converter={StaticResource ComponentIcon}}"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource App.TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border CornerRadius="6" Padding="8,3" Margin="10,0,0,0" Background="{DynamicResource App.BadgeNeutral}">
                            <TextBlock Text="{Binding ComponentType, Converter={StaticResource ComponentTypeLabel}}" FontSize="10.5" Foreground="{DynamicResource App.TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Secondary}" Margin="38,5,0,0" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource Text.Mono}"
                               Margin="38,4,20,0"
                               MaxHeight="34"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Reason}"
                               Style="{StaticResource Text.Meta}"
                               Margin="38,6,0,0"
                               Visibility="{Binding Reason, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding LastError}"
                               FontSize="11.5"
                               Foreground="#C05045"
                               TextWrapping="Wrap"
                               Margin="38,6,20,0"
                               Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource PauseStatusBrush}}" />
                        <TextBlock Text="{Binding Status, Converter={StaticResource PauseStatusLabel}}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource PauseStatusBrush}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PausedAt, Converter={StaticResource RelativeTime}}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Ui.Verify}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="{loc:Loc Ui.Restore}"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Margin="4,0,0,0"
                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Loc Ui.Forget}"
                                Style="{StaticResource GhostButton}"
                                Margin="4,0,0,0"
                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="BackupRowTemplate">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding SizeBytes, Converter={StaticResource FileSize}}"
                       Style="{StaticResource Text.Meta}"
                       VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TimelineChangeTemplate">
        <Border Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" Background="{DynamicResource App.SurfaceAlt}" CornerRadius="7">
                    <Path Width="14"
                          Height="14"
                          Data="{Binding Type, Converter={StaticResource ComponentIcon}}"
                          Stretch="Uniform"
                          Stroke="{Binding Kind, Converter={StaticResource KindBrush}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ChangeLabel}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
