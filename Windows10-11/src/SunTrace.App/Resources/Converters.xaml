<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SunTrace.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:CountToVisibilityConverter x:Key="ZeroCountToVisibility" Invert="True" />
    <conv:AppStatusToBrushConverter x:Key="AppStatusBrush" />
    <conv:AppStatusToLabelConverter x:Key="AppStatusLabel" />
    <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush" />
    <conv:ConfidenceToLabelConverter x:Key="ConfidenceLabel" />
    <conv:ImportanceToBrushConverter x:Key="ImportanceBrush" />
    <conv:ImportanceToSoftBrushConverter x:Key="ImportanceSoftBrush" />
    <conv:ImportanceToLabelConverter x:Key="ImportanceLabel" />
    <conv:KindToBrushConverter x:Key="KindBrush" />
    <conv:PauseStatusToBrushConverter x:Key="PauseStatusBrush" />
    <conv:PauseStatusToLabelConverter x:Key="PauseStatusLabel" />
    <conv:ComponentTypeToIconConverter x:Key="ComponentIcon" />
    <conv:ComponentTypeToLabelConverter x:Key="ComponentTypeLabel" />
    <conv:ChangeKindToLabelConverter x:Key="ChangeKindLabel" />
    <conv:SearchKindToIconConverter x:Key="SearchIcon" />
    <conv:RelativeTimeConverter x:Key="RelativeTime" />
    <conv:FriendlyDateConverter x:Key="FriendlyDate" />
    <conv:DayLabelConverter x:Key="DayLabel" />
    <conv:FileSizeConverter x:Key="FileSize" />
    <conv:SectionToCheckedConverter x:Key="SectionChecked" />
    <conv:TopLevelBooleanConverter x:Key="IndexChecked" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

</ResourceDictionary>
