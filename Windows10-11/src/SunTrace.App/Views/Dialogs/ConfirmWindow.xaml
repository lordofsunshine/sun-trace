<Window x:Class="SunTrace.App.Views.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="486"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource App.FontFamily}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="SunTrace" Style="{StaticResource Text.Meta}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Click="Cancel_Click">
                    <Path Width="10" Height="10" Data="{StaticResource Icon.Close}" Stretch="Uniform"
                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <TextBlock Text="{Binding Message}"
                       Style="{StaticResource Text.Body}"
                       Margin="0,16,0,0"
                       LineHeight="20" />

            <Border Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="0,14,0,0"
                    Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{Binding ActionText}"
                        Style="{StaticResource GhostButton}"
                        Click="Action_Click"
                        MinWidth="124"
                        Margin="0,0,8,0"
                        Visibility="{Binding ActionText, Converter={StaticResource StringToVisibility}}" />
                <Button Content="{Binding CancelText}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        MinWidth="104"
                        Margin="0,0,8,0"
                        Visibility="{Binding CancelText, Converter={StaticResource StringToVisibility}}" />
                <Button Click="Primary_Click" MinWidth="120">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                            <Setter Property="Background" Value="{DynamicResource App.DialogPrimary}" />
                            <Setter Property="Foreground" Value="#23190A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Danger}" Value="True">
                                    <Setter Property="Background" Value="#C05045" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
