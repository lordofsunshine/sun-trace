<Window x:Class="SunTrace.App.Views.Dialogs.TrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunTrace.App.Controls"
        xmlns:loc="clr-namespace:SunTrace.App.Localization"
        Width="680"
        SizeToContent="Height"
        MaxHeight="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource App.FontFamily}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="22,18" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SunMark Width="30" Height="30" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Ui.TrackingTitle}" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{loc:Loc Ui.TrackingSubtitle}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Click="Close_Click">
                        <Path Width="10" Height="10" Data="{StaticResource Icon.Close}" Stretch="Uniform"
                              Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                <StackPanel Margin="22,18">
                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="15" Height="15" Data="{StaticResource Icon.Info}" Stretch="Uniform"
                                  Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,9,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Style="{StaticResource ProgressLine}" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Meta}" Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Ui.HowItWorks}" Style="{StaticResource Text.H3}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource App.AccentSoft}">
                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc Ui.TrackingStep1Title}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Ui.TrackingStep1Text}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource App.AccentSoft}">
                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc Ui.TrackingStep2Title}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Ui.TrackingStep2Text}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource App.AccentSoft}">
                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc Ui.TrackingStep3Title}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Ui.TrackingStep3Text}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{loc:Loc Ui.StartTracking}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"
                                Command="{Binding StartCommand}" MinWidth="170" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Ui.UnfinishedSession}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:Loc Ui.UnfinishedSessionText}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Loc Ui.Resume}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" MinWidth="130" />
                            <Button Content="{loc:Loc Ui.DiscardSession}" Style="{StaticResource GhostButton}" Command="{Binding DiscardSessionCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAwaitingInstall, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Ui.InstallProgram}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:Loc Ui.InstallProgramText}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />

                        <Border Style="{StaticResource CardMuted}" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{DynamicResource App.Surface}" CornerRadius="7">
                                    <Path Width="14" Height="14" Data="{StaticResource Icon.Package}" Stretch="Uniform"
                                          Stroke="{DynamicResource App.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Ui.Installer}" Style="{StaticResource Text.Meta}" />
                                    <TextBlock Text="{Binding InstallerLabel}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{loc:Loc Ui.Choose}" Style="{StaticResource GhostButton}" Command="{Binding ChooseInstallerCommand}" />
                                    <Button Content="{loc:Loc Ui.Run}" Style="{StaticResource SecondaryButton}" Height="30" Margin="4,0,0,0"
                                            Command="{Binding RunInstallerCommand}"
                                            Visibility="{Binding HasInstaller, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="{loc:Loc Ui.InstallFinished}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Command="{Binding FinishCommand}" MinWidth="180" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#252F8F5B">
                                <Path Width="13" Height="13" Data="{StaticResource Icon.Check}" Stretch="Uniform"
                                      Stroke="#2F8F5B" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Text.H2}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding NewAppsLabel}" Style="{StaticResource Text.LabelCaps}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding NewApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardMuted}" Padding="12,9" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayVersion}" Style="{StaticResource Text.Meta}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding EventsLabel}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#28C05045">
                                <Path Width="13" Height="13" Data="{StaticResource Icon.Alert}" Stretch="Uniform"
                                      Stroke="#C05045" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc Ui.TrackingFailed}" Style="{StaticResource Text.H3}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                        <Button Content="{loc:Loc Ui.TryAgain}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding StartCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="22,14" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Ui.DataStaysHere}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Loc Ui.Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" MinWidth="96" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
