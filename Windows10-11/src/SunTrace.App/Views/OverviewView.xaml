<UserControl x:Class="SunTrace.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SunTrace.App.Controls"
             xmlns:loc="clr-namespace:SunTrace.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,8">
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2F8F5B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Main.IsMonitoringEnabled}" Value="False">
                                                <Setter Property="Fill" Value="#B9821F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Main.MonitoringLabel}" Style="{StaticResource Text.H2}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" />
                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding LastScanDisplay}" Style="{StaticResource Text.Meta}" Margin="0,0,14,3" />
                            <TextBlock Text="{Binding Main.NextScanLabel}" Style="{StaticResource Text.Meta}" Margin="0,0,0,3" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />

                    <UniformGrid x:Name="StatsGrid" Columns="4" Margin="-4,0">
                        <Border Style="{StaticResource CardMuted}" Padding="14,12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.Programs}" Style="{StaticResource Text.LabelCaps}" />
                                <TextBlock Text="{Binding Stats.AppCount}" Style="{StaticResource Text.StatValue}" Margin="0,3,0,0" />
                                <TextBlock Text="{loc:Loc Ui.FoundInSystem}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardMuted}" Padding="14,12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.Changes}" Style="{StaticResource Text.LabelCaps}" />
                                <TextBlock Text="{Binding Stats.EventsLast7Days}" Style="{StaticResource Text.StatValue}" Margin="0,3,0,0" />
                                <TextBlock Text="{loc:Loc Ui.Last7Days}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardMuted}" Padding="14,12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.Snapshots}" Style="{StaticResource Text.LabelCaps}" />
                                <TextBlock Text="{Binding Stats.SnapshotCount}" Style="{StaticResource Text.StatValue}" Margin="0,3,0,0" />
                                <TextBlock Text="{loc:Loc Ui.StoredInHistory}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardMuted}" Padding="14,12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.Updates}" Style="{StaticResource Text.LabelCaps}" />
                                <TextBlock Text="{Binding Stats.UpdatedAppsLast30Days}" Style="{StaticResource Text.StatValue}" Margin="0,3,0,0" />
                                <TextBlock Text="{loc:Loc Ui.Last30Days}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid x:Name="BottomGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="BottomSecondRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecentColumn" Width="2*" />
                    <ColumnDefinition x:Name="BottomGap" Width="16" />
                    <ColumnDefinition x:Name="SideColumn" Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14"
                        Visibility="{Binding HasRecentEvents, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ui.RecentChanges}" Style="{StaticResource Text.H3}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Ui.History}" Style="{StaticResource InlineLinkButton}" Command="{Binding OpenHistoryCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentEvents}" ItemTemplate="{StaticResource EventCardTemplate}"
                                      Visibility="{Binding HasRecentEvents, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>
                </Border>

                <StackPanel x:Name="SidePanel" Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16"
                            Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Ui.AttentionTitle}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{Binding AttentionSummary}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{loc:Loc Ui.All}" Style="{StaticResource InlineLinkButton}" Command="{Binding OpenAttentionCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AttentionItems}"
                                          Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Height="58" Margin="0,0,0,6"
                                                Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:AppIcon Size="28" AppName="{Binding Name}" IconPath="{Binding App.MainExecutablePath}" />
                                                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource AppStatusLabel}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource AppStatusBrush}}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding LastChangeAt, Converter={StaticResource FriendlyDate}}"
                                                               Style="{StaticResource Text.Meta}"
                                                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                            Visibility="{Binding HasTrackedComponents, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Ui.TrackedTitle}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{Binding SnapshotsSavedLabel}" Style="{StaticResource Text.Meta}" Margin="0,3,0,8" />
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Icon.Startup}" Stretch="Uniform"
                                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc Ui.Startup}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Stats.StartupCount}" Style="{StaticResource Text.Secondary}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Icon.Service}" Stretch="Uniform"
                                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc Ui.Services}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ServiceCount}" Style="{StaticResource Text.Secondary}" />
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Icon.Task}" Stretch="Uniform"
                                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc Ui.Tasks}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Stats.TaskCount}" Style="{StaticResource Text.Secondary}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10" />
                            <Button Content="{loc:Loc Ui.OpenAllPrograms}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0"
                                    Command="{Binding OpenChangedCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
