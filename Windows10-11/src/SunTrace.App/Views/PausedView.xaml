<UserControl x:Class="SunTrace.App.Views.PausedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SunTrace.App.Controls"
             xmlns:loc="clr-namespace:SunTrace.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,8">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{DynamicResource App.AccentSoft}" CornerRadius="8" VerticalAlignment="Top">
                        <Path Width="20" Height="20" Data="{StaticResource Icon.Shield}" Stretch="Uniform"
                              Stroke="{DynamicResource App.AccentText}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Ui.SafePause}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:Loc Ui.SafePauseDescription}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" MaxWidth="780" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" />

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardMuted}" Padding="3" CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentTab}"
                                     GroupName="PausedFilter"
                                     Content="{Binding ActiveLabel}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="Active"
                                     IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=Active, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource SegmentTab}"
                                     GroupName="PausedFilter"
                                     Content="{Binding HistoryLabel}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="History"
                                     IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=History, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource SegmentTab}"
                                     GroupName="PausedFilter"
                                     Content="{loc:Loc Ui.All}"
                                     Command="{Binding SetFilterCommand}"
                                     CommandParameter="All"
                                     IsChecked="{Binding Filter, Converter={StaticResource SectionChecked}, ConverterParameter=All, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc Ui.RestoreNotice}" Style="{StaticResource Text.Meta}"
                           TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PausedCardTemplate}"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyStateView Title="{Binding EmptyTitle}"
                                     Message="{Binding EmptyMessage}"
                                     Icon="{DynamicResource Icon.PauseCircle}"
                                     Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Style="{StaticResource CardMuted}" Padding="16" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Data="{StaticResource Icon.Info}" Stretch="Uniform"
                          Stroke="{DynamicResource App.TextTertiary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ui.ReadOnlyTitle}" Style="{StaticResource Text.H3}" FontSize="12.5" />
                        <TextBlock Text="{loc:Loc Ui.ReadOnlyDescription}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" MaxWidth="760"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
