<UserControl x:Class="SunTrace.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SunTrace.App.Controls"
             xmlns:localization="clr-namespace:SunTrace.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,8">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Text.Secondary}" MaxWidth="620"
                           HorizontalAlignment="Left" TextAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding SaveState}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Appearance]}" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.ThemeDescription]}" Style="{StaticResource Text.Meta}" Margin="0,3,0,14" />
                    <Border Style="{StaticResource CardMuted}" Padding="3" CornerRadius="9" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="ThemeChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.System]}"
                                         Command="{Binding SetThemeCommand}"
                                         CommandParameter="0"
                                         IsChecked="{Binding ThemeIndex, Converter={StaticResource IndexChecked}, ConverterParameter=0, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="ThemeChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Light]}"
                                         Command="{Binding SetThemeCommand}"
                                         CommandParameter="1"
                                         IsChecked="{Binding ThemeIndex, Converter={StaticResource IndexChecked}, ConverterParameter=1, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="ThemeChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Dark]}"
                                         Command="{Binding SetThemeCommand}"
                                         CommandParameter="2"
                                         IsChecked="{Binding ThemeIndex, Converter={StaticResource IndexChecked}, ConverterParameter=2, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Language]}" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.LanguageDescription]}" Style="{StaticResource Text.Meta}" Margin="0,3,0,14" />
                    <Border Style="{StaticResource CardMuted}" Padding="3" CornerRadius="9" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="LanguageChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.System]}"
                                         Command="{Binding SetLanguageCommand}"
                                         CommandParameter="0"
                                         IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexChecked}, ConverterParameter=0, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="LanguageChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Russian]}"
                                         Command="{Binding SetLanguageCommand}"
                                         CommandParameter="1"
                                         IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexChecked}, ConverterParameter=1, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SegmentTab}"
                                         GroupName="LanguageChoice"
                                         Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.English]}"
                                         Command="{Binding SetLanguageCommand}"
                                         CommandParameter="2"
                                         IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexChecked}, ConverterParameter=2, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Monitoring]}" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.MonitoringDescription]}" Style="{StaticResource Text.Meta}" Margin="0,3,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.WatchChanges]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.WatchChangesDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,0,0,0" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.ScanInterval]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.ScanIntervalDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource Dropdown}" Width="190"
                                  ItemsSource="{Binding ScanIntervalOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ScanIntervalMinutes, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.HistoryDepth]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.HistoryDepthDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource Dropdown}" Width="190"
                                  ItemsSource="{Binding RetentionOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SnapshotRetention, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.NotificationsAndStartup]}" Style="{StaticResource Text.H3}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Notify]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.NotifyDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.StartWithWindows]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.StartWithWindowsDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.DataAndBackups]}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.LocalHistory]}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.OpenFolder]}" Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.CopyPath]}" Style="{StaticResource GhostButton}" Command="{Binding CopyDataPathCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardMuted}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding DatabaseSizeLabel}" Style="{StaticResource Text.Meta}" />
                                    <TextBlock Text="·" Margin="6,0" Style="{StaticResource Text.Meta}" />
                                    <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Check]}" Style="{StaticResource GhostButton}" Command="{Binding CheckIntegrityCommand}" />
                                <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.CreateBackup]}" Style="{StaticResource SecondaryButton}" Height="30" Margin="4,0,0,0"
                                        Command="{Binding CreateBackupCommand}" />
                                <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Restore]}" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                        Command="{Binding RestoreBackupCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource Dropdown}" Height="42"
                                  ItemsSource="{Binding Backups}"
                                  SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource BackupRowTemplate}"
                                  IsEnabled="{Binding HasBackups}" />
                        <TextBlock Grid.Column="1" Text="{Binding LastBackupLabel}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.ClearHistory]}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="#C05045" />
                            <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.ClearHistoryDescription]}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Clear]}" Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.About]}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.AboutDescription]}"
                                   Style="{StaticResource Text.Meta}" Margin="0,6,0,0" MaxWidth="620" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Logs]}" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsFolderCommand}" />
                            <Button Content="{Binding Source={x:Static localization:LocalizedStrings.Instance}, Path=[Settings.Export]}" Style="{StaticResource GhostButton}" Command="{Binding OpenExportsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <controls:SunMark Grid.Column="1" Width="42" Height="42" VerticalAlignment="Top" Margin="20,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
